# Optional. Copy to .env to override defaults.

# SQLite for local use. For Postgres/Supabase:
#   postgresql+psycopg://user:pass@host:5432/portfolio
PORTFOLIO_DATABASE_URL=sqlite:///./data/portfolio.db

# Largest statement PDF accepted, in MB.
PORTFOLIO_MAX_UPLOAD_MB=20

# Statements older than this many days are flagged on the dashboard.
PORTFOLIO_STALE_AFTER_DAYS=45

# Allow the "Refresh NAVs" button to download AMFI's public NAV file (the only network request the
# app makes; nothing about your holdings is sent). Set to false to keep the app fully offline.
PORTFOLIO_FETCH_PRICES=true
