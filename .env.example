# Optional. Copy to .env to override defaults.

# SQLite for local use. For Postgres/Supabase:
#   postgresql+psycopg://user:pass@host:5432/portfolio
PORTFOLIO_DATABASE_URL=sqlite:///./data/portfolio.db

# Largest statement PDF accepted, in MB.
PORTFOLIO_MAX_UPLOAD_MB=20

# Statements older than this many days are flagged on the dashboard.
PORTFOLIO_STALE_AFTER_DAYS=45

# Allow the "Refresh prices" button to download public end-of-day files (AMFI fund NAVs, NSE and
# BSE closing prices). These are the only network requests the app makes; nothing about your
# holdings is sent. Set to false to keep the app fully offline.
PORTFOLIO_FETCH_PRICES=true

# Backups: python -m portfolio.backup create. Newest N are kept. To keep copies safe off the device, set a
# gpg public key here: backups are encrypted to it and only whoever holds the private key can read them.
PORTFOLIO_BACKUP_DIR=data/backups
PORTFOLIO_BACKUP_KEEP=14
# PORTFOLIO_BACKUP_GPG_RECIPIENT=you@example.com

# A single position above this share (in percent) of your portfolio is flagged under Concentration.
PORTFOLIO_CONCENTRATION_ALERT_PCT=10
